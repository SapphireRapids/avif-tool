<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>StressHarness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvifForge\AvifForge.csproj" />
  </ItemGroup>

  <!-- avifenc.exe 通过启动参数 engine 指定（CI 从 release MSI 取出后放 tools\avifenc.exe） -->
  <ItemGroup>
    <None Include="..\..\tools\avifenc.exe" Link="avifenc.exe" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\tools\avifenc.exe')" />
  </ItemGroup>

</Project>
