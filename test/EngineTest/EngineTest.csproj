<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvifForge\AvifForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\avifenc.exe" Link="avifenc.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tools\avifenc.exe')" />
  </ItemGroup>

</Project>
