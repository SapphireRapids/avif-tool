<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Online restore (default): WPF-UI 4.3.0 + CommunityToolkit.Mvvm 8.4.2 come from nuget.org.
       The .NET 10 win-x64 runtime packs for self-contained publish are fetched the same way. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Fully offline restore: point NuGet at an already-extracted package folder that holds
       wpf-ui, communitytoolkit.mvvm and the 10.0.x win-x64 runtime packs, then build with
           .\build.ps1 -NugetRoot 'D:\path\to\.nuget-packages'
       build.ps1 sets NUGET_PACKAGES and -p:RestoreSources for that case, so this file can
       stay as it is. If you prefer to configure it here instead, uncomment:
  <config>
    <add key="globalPackagesFolder" value="..\..\.nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="offline-extracted-cache" value="..\..\.nuget-packages" />
  </packageSources>
  -->
</configuration>
